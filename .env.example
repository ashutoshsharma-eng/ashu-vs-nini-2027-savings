# Neon Postgres connection string (tables + seed data are created automatically on first load)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# 4-digit login PINs (default to 1111 / 2222 if unset — a warning banner is shown)
HUSBAND_PIN="1111"
WIFE_PIN="2222"

# Optional: secret for signing the login cookie. If unset, one is derived from the PINs
# and DATABASE_URL (so changing a PIN signs everyone out).
# AUTH_SECRET=""
