# Neon Postgres connection string (tables + seed data are created automatically on first load)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Needed once, to create your group on a brand-new deployment (any word or number you like).
# Stops a stranger who finds the URL from claiming the app before you do.
SETUP_CODE="pick-something-secret"

# Optional: secret for signing login cookies. If unset, one is derived from DATABASE_URL.
# AUTH_SECRET=""

# Only used when upgrading the original two-player version: the existing PINs for Ashutosh and
# Niharika. After the upgrade, PINs live (hashed) in the database and are changed in ⚙️ Settings.
# HUSBAND_PIN="1111"
# WIFE_PIN="2222"
